{
  "name": "livrelibre",
  "version": "5.2.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,green \"pnpm dev:server\" \"pnpm dev:web\"",
    "dev:server": "pnpm --filter @livrelibre/server dev",
    "dev:web": "pnpm --filter @livrelibre/web dev",
    "build": "pnpm typecheck && pnpm --filter @livrelibre/web build && pnpm --filter @livrelibre/server build",
    "start": "pnpm --filter @livrelibre/server start",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "check": "pnpm lint && pnpm typecheck",
    "format": "prettier --write apps packages tests --cache",
    "generate:db": "pnpm --filter @livrelibre/server generate:db",
    "migrate:db": "pnpm --filter @livrelibre/server migrate:db",
    "test": "pnpm --filter @livrelibre/tests test",
    "test:unit": "pnpm --filter @livrelibre/tests test:unit",
    "test:integration": "pnpm --filter @livrelibre/tests test:integration",
    "test:e2e": "pnpm --filter @livrelibre/tests test:e2e",
    "test-ui": "pnpm --filter @livrelibre/tests test-ui"
  },
  "devDependencies": {
    "@trivago/prettier-plugin-sort-imports": "6.0.2",
    "concurrently": "10.0.5",
    "prettier": "3.9.6"
  },
  "packageManager": "pnpm@11.20.0+sha512.9a6f330a95b66446ea088faf1521405a8a01f07fde7124cc9958dfed52d4bb436737e65b08f85f37b46fcba375092558ac51262b816844b22f63406ed166bfee"
}
