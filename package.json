{
  "name": "livrelibre",
  "version": "4.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,green \"pnpm dev:server\" \"pnpm dev:web\"",
    "dev:server": "pnpm --filter @livrelibre/server dev",
    "dev:web": "pnpm --filter @livrelibre/web dev",
    "build": "pnpm --filter @livrelibre/web build",
    "preview": "pnpm --filter @livrelibre/web preview",
    "lint": "pnpm --filter @livrelibre/web lint && pnpm --filter @livrelibre/server lint && pnpm --filter @livrelibre/shared lint && eslint .",
    "format": "prettier --write apps packages tests --cache",
    "generate:db": "drizzle-kit generate",
    "migrate:db": "drizzle-kit migrate",
    "test": "pnpm test:unit && pnpm test:integration",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration --config vitest.integration.config.mts",
    "test:e2e": "pnpm exec playwright test",
    "test-ui": "pnpm exec playwright test --ui"
  },
  "dependencies": {
    "@livrelibre/server": "workspace:*",
    "@livrelibre/shared": "workspace:*",
    "dotenv": "17.4.2"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@trivago/prettier-plugin-sort-imports": "6.0.2",
    "@trpc/server": "11.18.0",
    "@types/node": "26.2.0",
    "concurrently": "10.0.5",
    "date-fns": "4.4.0",
    "drizzle-kit": "0.31.10",
    "drizzle-orm": "0.45.2",
    "eslint": "9.39.5",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vitest": "4.1.11"
  },
  "packageManager": "pnpm@11.20.0+sha512.9a6f330a95b66446ea088faf1521405a8a01f07fde7124cc9958dfed52d4bb436737e65b08f85f37b46fcba375092558ac51262b816844b22f63406ed166bfee"
}
