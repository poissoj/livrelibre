{
  "name": "@livrelibre/tests",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "pnpm test:unit && pnpm test:integration",
    "test:unit": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.mts",
    "test:e2e": "playwright test --project=chromium",
    "test:e2e:all": "playwright test",
    "test-ui": "playwright test --ui",
    "typecheck": "tsc --noEmit",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@livrelibre/server": "workspace:*",
    "@livrelibre/shared": "workspace:*",
    "@playwright/test": "1.64.0",
    "@trpc/server": "catalog:",
    "@types/bcrypt": "catalog:",
    "@types/node": "catalog:",
    "bcrypt": "catalog:",
    "date-fns": "catalog:",
    "dotenv": "catalog:",
    "drizzle-orm": "catalog:",
    "eslint": "catalog:",
    "hono": "catalog:",
    "postgres": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vitest": "5.0.3"
  }
}
