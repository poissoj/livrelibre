# Secret used to sign session JWTs (min 32 chars)
# Generate with: openssl rand -base64 32
SESSION_SECRET=

# PostgreSQL connection string
POSTGRES_URI=postgres://user:password@localhost:5432/livrelibre

# --- Optional ---

# Server port (default: 3001)
# PORT=3001

# Test database (integration + e2e tests)
# TEST_POSTGRES_URI=postgres://user:password@localhost:5432/livrelibre_test

# App name shown in the UI (default: Livre Libre)
# VITE_APP_NAME=Livre Libre

# ISBN lookup service URL
# ISBN_SEARCH_URL=
