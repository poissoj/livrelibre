# Copiez ce fichier en `.env.local` (gitignoré) pour surcharger les défauts
# de `.env` (versionné). N'y mettre que des variables publiques VITE_*.

# Name shown in the UI (default: Livre Libre)
# VITE_APP_NAME=Livre Libre

# Site favicon: absolute path to a file in apps/web/public (e.g. /my-favicon.png)
# or a full URL. Must start with "/" or "http(s)://" (default: /favicon.ico)
# VITE_FAVICON=/my-favicon.png
