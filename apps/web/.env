# Defaults versionnés. Surcharger en local via `.env.local` (gitignoré).
# Ne mettre ici que des variables publiques VITE_*.

# Name shown in the UI (default: Livre Libre)
VITE_APP_NAME=Livre Libre

# Default favicon. Override in .env.local.
# Must be an absolute path (/...) or a full URL.
VITE_FAVICON=/favicon.ico
