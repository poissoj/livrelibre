{
  "name": "@livrelibre/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./app": "./src/app.ts",
    "./db/database": "./src/db/database.ts",
    "./db/migrate": "./src/db/migrate.ts",
    "./router": "./src/router.ts",
    "./server/addItem": "./src/server/addItem.ts",
    "./server/bestSales": "./src/server/bestSales.ts",
    "./server/bookmarks": "./src/server/bookmarks.ts",
