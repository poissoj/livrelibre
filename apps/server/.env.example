# Secret used to sign session JWTs (min 32 chars)
# Generate with: openssl rand -base64 32
SESSION_SECRET=

# PostgreSQL connection string
POSTGRES_URI=postgres://user:password@localhost:5432/livrelibre

# --- Optional ---

# Server port (default: 3001)
# PORT=3001

# ISBN lookup service URL
# ISBN_SEARCH_URL=

# Log level: error | warn | info | http | verbose | debug | silly (default: info)
# LOG_LEVEL=info
