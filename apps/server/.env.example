# Secret used to sign session JWTs (min 32 chars)
# Generate with: openssl rand -base64 32
SESSION_SECRET=

# PostgreSQL connection string
POSTGRES_URI=postgres://user:password@localhost:5432/livrelibre

# --- Optional ---

# Server port (default: 3001)
# PORT=3001

# ISBN lookup service URL
# ISBN_SEARCH_URL=

# Log level: error | warn | info | http | verbose | debug | silly (default: info)
# LOG_LEVEL=info

# Node environment: development | test | production (default: development)
# NODE_ENV=development

# Timezone used for statistics and dates (IANA name, default: Europe/Paris)
# TIMEZONE=Europe/Paris

# PostgreSQL connection pool (per process)
# Max number of pooled connections (default: 5)
# DB_POOL_MAX=5
# Seconds before releasing an idle connection, 0 = never (default: 30)
# DB_IDLE_TIMEOUT=30
# Seconds to wait for a new connection (default: 5)
# DB_CONNECT_TIMEOUT=5
# Seconds a connection can live, 0 = unlimited (default: 0)
# DB_MAX_LIFETIME=0

# Shop identifier used by the Place des Libraires export CLI (required by it)
# SHOP_ID=

# FTP destination for the stock export CLI (optional, export is skipped if unset)
# FTP_HOST=
# FTP_USER=
# FTP_PASSWORD=
